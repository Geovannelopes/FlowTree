APP_NAME=FlowTree
APP_ENV=local
APP_KEY=base64:bKsjruiakRFLU/QqMPet1eVL+qNfDYAzV1pLl3enXL4=
APP_DEBUG=true
APP_URL=http://localhost:5100
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# SPA (links de e-mail, ex.: redefinição de senha)
FRONTEND_URL=http://localhost:9050

# Admin criado pelo seeder (em produção, é o único usuário semeado)
ADMIN_NAME="Administrador"
ADMIN_EMAIL=admin@flowtree.test
ADMIN_PASSWORD=password

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL (serviço `mysql` do docker-compose)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=flowtree
DB_USERNAME=flowtree
DB_PASSWORD=flowtree

# API stateless (JWT): sem sessão
SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=flowtree-cache-

# Redis (serviço `redis` do docker-compose): cache, filas e blacklist do JWT
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=flowtree-

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@flowtree.test"
MAIL_FROM_NAME="${APP_NAME}"

# JWT (php-open-source-saver/jwt-auth). Gere com: php artisan jwt:secret
JWT_SECRET=RrZVrFCJs3Mv1rdSt2PiHtu4IAajxl1JnfG426AZDQ5R5IbYONHPQw6yapu2iROI
JWT_ALGO=HS256
JWT_TTL=60
JWT_REFRESH_TTL=20160
JWT_LEEWAY=5

# Realtime (Laravel Reverb / WebSocket)
REVERB_APP_ID=798668
REVERB_APP_KEY=1612c805c9d386978b60
REVERB_APP_SECRET=8f8617eb10251b5fff165046e6580476
# Servidor Reverb: bind interno (via supervisor); o nginx do container faz proxy de /app
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=6100
# Onde o Laravel publica os eventos (Reverb local, mesmo container)
REVERB_HOST=127.0.0.1
REVERB_PORT=6100
REVERB_SCHEME=http
