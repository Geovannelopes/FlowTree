# Variáveis lidas pelo docker-compose.yml (copie para .env).

# MySQL (container flowtree-mysql; sem porta publicada, só na rede interna)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=flowtree
MYSQL_USER=flowtree
MYSQL_PASSWORD=flowtree

# Reverb (WebSocket). Os mesmos valores vão para o api (ambiente) e para o build do app.
# Gere: id = número qualquer; key = openssl rand -hex 10; secret = openssl rand -hex 16
REVERB_APP_ID=798668
REVERB_APP_KEY=1612c805c9d386978b60
REVERB_APP_SECRET=8f8617eb10251b5fff165046e6580476

# --- Domínios públicos (proxy externo termina o TLS) ---------------------------
# APP_URL: onde o navegador abre o FlowTree. O proxy aponta para a porta 9050 e
# essa única URL serve front, /api, /docs e /storage.
APP_URL=http://localhost:9050

# WebSocket do Reverb em domínio próprio: o proxy aponta para a porta 6100.
# Deixe os três vazios para o WebSocket sair pela mesma origem do front (/app).
REVERB_PUBLIC_HOST=
REVERB_PUBLIC_PORT=
REVERB_PUBLIC_SCHEME=

# Interface onde a porta 6100 do Reverb é publicada. Padrão "127.0.0.1:" (só o
# host). Use "" (vazio) se o proxy externo não roda nesta máquina.
REVERB_BIND=127.0.0.1:

# 1 = login já preenchido com admin@flowtree.test / password (use 0 em produção).
DEMO_LOGIN=1
