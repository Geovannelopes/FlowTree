# ATENÇÃO: este arquivo vale APENAS para rodar o front fora do Docker
# (`npm run dev` / `npm run build` no host). No deploy com Docker ele é ignorado
# (veja .dockerignore): lá os VITE_* vêm dos build.args do compose, a partir do
# .env da RAIZ, e são embutidos no bundle durante o build da imagem.

# Domínio do backend para o navegador chamar direto. Vazio = caminho relativo /api
# (o proxy do Vite em dev manda para VITE_API_PROXY_TARGET — mesma origem, sem CORS).
VITE_API_URL=

# Alvo interno do proxy /api, /storage e /app (WebSocket) do Vite em dev.
# Padrão fora do Docker: http://localhost:5100. Dentro do Compose: http://api:80.
VITE_API_PROXY_TARGET=http://localhost:5100

# Realtime (Reverb). Vazio = desligado (o app segue funcionando sem tempo real).
#   VITE_REVERB_APP_KEY = mesma REVERB_APP_KEY do api/.env
#   VITE_REVERB_HOST/PORT/SCHEME vazios = mesma origem da página (proxy /app do nginx/Vite)
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=
VITE_REVERB_PORT=
VITE_REVERB_SCHEME=

# 1 = formulário de login já preenchido com admin@flowtree.test / password (só dev/demo).
VITE_DEMO_LOGIN=1
